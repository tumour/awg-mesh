#!/bin/bash
# prerm — выполняется ДО удаления пакета (apt remove / dpkg -r).
# state.json не трогаем — он сохраняется на случай если ставим обратно
# или upgrade'ит до более новой версии. Полный cleanup — postrm с purge.

set -e

if [ -d /run/systemd/system ]; then
    systemctl stop meshd.service >/dev/null 2>&1 || true
    systemctl disable meshd.service >/dev/null 2>&1 || true
fi

# Снести TUN-интерфейс если daemon не успел graceful shutdown.
ip link delete dev awg0 >/dev/null 2>&1 || true

# Снять UFW-правило для mesh-интерфейса (добавили в postinst).
if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q 'Status: active'; then
    ufw delete allow in on awg0 >/dev/null 2>&1 || true
fi

exit 0
