#!/bin/bash
# postinst — выполняется после распаковки .deb-пакета.
# Идемпотентно: повторный install не ломает существующую инсталляцию.

set -e

# Создаём state-директорию с правильными правами.
# chmod 700 потому что внутри хранится private-key + cluster-secret.
mkdir -p /etc/meshd
chmod 700 /etc/meshd

# systemd: подхватить новый/обновлённый unit-file.
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true

    # Enable чтобы при ребуте стартовал автоматом. Не start —
    # пока нет state.json, daemon упадёт.
    systemctl enable meshd.service >/dev/null 2>&1 || true

    # Если state.json уже есть (upgrade существующей установки) — рестарт
    # подхватит новый бинарь.
    if [ -f /etc/meshd/state.json ]; then
        systemctl restart meshd.service || true
        echo "✓ meshd upgraded and restarted"
    else
        cat <<'EOF'
✓ meshd installed

  Next: bootstrap this node into a mesh:

    meshd init  --label <name> --public-endpoint <public-ip>:51820
    # ...or join an existing mesh:
    meshd join --label <name> --token <TOKEN_FROM_INIT_OUTPUT>

  Daemon starts automatically after init/join.
EOF
    fi
fi

# UFW: разрешить весь входящий трафик с mesh-интерфейса awg0 (trust-by-tunneling:
# peers внутри mesh уже прошли Noise IKpsk2 + cluster-secret). Снаружи (eth0)
# gossip-API не достижим — listener binds на mesh-IP, плюс UFW дропает по default.
#
# Tailscale-pattern: default-allow на tunnel-interface, ACL для restriction —
# опциональны (для нашего MVP scope не нужны).
#
# UFW rule добавляется в idle-state (даже когда awg0 ещё не существует) —
# применится автоматически когда meshd run создаст интерфейс.
if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q 'Status: active'; then
    if ! ufw status | grep -q 'Anywhere on awg0'; then
        ufw allow in on awg0 comment 'mesh internal (trust-by-tunneling)' >/dev/null 2>&1 || true
        echo "✓ UFW: allow in on awg0 (mesh internal)"
    fi
fi

exit 0
