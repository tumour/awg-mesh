#!/bin/sh /etc/rc.common
# procd init-скрипт для meshd (OpenWrt-аналог deploy/systemd/meshd.service).
# Ставится в /etc/init.d/meshd через .apk-пакет.

START=80
STOP=20
USE_PROCD=1

PROG=/usr/bin/meshd
STATE=/etc/meshd/state.json

start_service() {
	# Аналог ConditionPathExists: без state.json демону нечего поднимать —
	# init/join создадут state и сами запустят сервис.
	[ -f "$STATE" ] || {
		echo "meshd: no $STATE yet, run 'meshd init' or 'meshd join' first"
		return 0
	}

	procd_open_instance
	procd_set_param command "$PROG" run
	# respawn: окно 3600s, пауза 5s, retry 0 = бесконечно (как Restart=on-failure).
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
